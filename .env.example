# Copiare in .env e compilare i due segreti PRIMA di avviare il laboratorio.
# Usare valori casuali esadecimali, senza spazi, $ o # (interpolazione Compose).
POSTGRES_DB=flights
POSTGRES_USER=flights_lab
POSTGRES_PASSWORD=
JUPYTER_TOKEN=
# Il bind 127.0.0.1 è fisso nel Compose; PostgreSQL non pubblica porte host.
JUPYTER_PORT=8888

# Windows/macOS: lasciare 1000. Linux nativo: impostare UID/GID dell'utente host
# prima del primo build, per scrivere nei bind mount senza eseguire come root.
LAB_UID=1000
LAB_GID=1000

# Budget iniziali per Docker con circa 7,58 GiB disponibili: non tuning del FULL.
JUPYTER_MEMORY_LIMIT=1536m
POSTGRES_MEMORY_LIMIT=3g
JUPYTER_CPUS=2.0
POSTGRES_CPUS=2.0
MONGO_INITDB_ROOT_USERNAME=flights_admin
MONGO_INITDB_ROOT_PASSWORD=
MONGO_MEMORY_LIMIT=3g
MONGO_CPUS=2.0
# Cache esplicita entro il limite container, non una percentuale della RAM host.
MONGO_CACHE_GB=1
# CockroachDB single-node insecure solo nella rete locale Docker, mai produzione.
COCKROACH_MEMORY_LIMIT=3g
COCKROACH_CPUS=2.0
COCKROACH_CACHE=512MiB
COCKROACH_SQL_MEMORY=512MiB
